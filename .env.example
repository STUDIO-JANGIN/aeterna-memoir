# Copy to `.env.local` for development. In Vercel (Production), set production values and redeploy.

# Public app domain (OAuth redirect base → https://aeternamemoir.com/auth/callback)
NEXT_PUBLIC_APP_URL=https://aeternamemoir.com
NEXT_PUBLIC_SITE_URL=https://aeternamemoir.com

# Supabase API (NOT the custom domain — must be *.supabase.co from Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://clnxgqhbejscniwhvmjc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
