# Copy to `.env.local` for development. In Vercel (Production), set the same keys — use https://aeternamemoir.com for public URLs.

# Required for OAuth + links (production)
NEXT_PUBLIC_APP_URL=https://aeternamemoir.com
NEXT_PUBLIC_SITE_URL=https://aeternamemoir.com

# Supabase → Settings → API (Project URL + anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
