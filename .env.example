# Copy to `.env.local` for development.
#
# Production: set the same keys in Vercel → Environment Variables (Next.js reads process.env there).
# Values stored only in Supabase “Secrets” are NOT available to this Next.js app unless you also add them to Vercel.

# Public app domain (OAuth redirect base → https://aeternamemoir.com/auth/callback)
NEXT_PUBLIC_APP_URL=https://aeternamemoir.com
NEXT_PUBLIC_SITE_URL=https://aeternamemoir.com

# Supabase API (NOT the custom domain — must be *.supabase.co from Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://clnxgqhbejscniwhvmjc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Live Mode — use sk_live_… in production (Vercel). Test mode: sk_test_…
STRIPE_SECRET_KEY=
# Webhook signing secret from Dashboard → Webhooks → your endpoint (Live: whsec_live_…)
STRIPE_WEBHOOK_SECRET=
# Optional: override default master Price IDs (defaults are Live multi-currency IDs in code)
# STRIPE_PRICE_ID_PLUS=price_1TLQapRx4nwbdr0ovMVg8fdj
# STRIPE_PRICE_ID_PREMIUM=price_1TLQR9Rx4nwbdr0oo0wMzgVu

# Admin alerts (Stripe webhook → Slack / email). Required on Vercel for Slack from production.
# Slack: revenue, tips, family support, Luma film lifecycle, errors — see docs/SECRETS_AND_ALERTS.md
SLACK_WEBHOOK_URL=
# Or: SLACK_AETERNA_ALERT_WEBHOOK_URL=

# Email for Premium (AI Film) tier — Resend (https://resend.com): verify domain, then set a From address
RESEND_API_KEY=
RESEND_FROM="Aeterna <notifications@yourdomain.com>"
# Defaults to hoon@aya.yale.edu if unset; comma-separated for multiple recipients
PREMIUM_ALERT_EMAIL_TO=hoon@aya.yale.edu

# Luma Dream Machine (AI tribute film) — create key at https://lumalabs.ai/dream-machine/api/keys
LUMA_API_KEY=
# Optional override (default: https://api.lumalabs.ai/dream-machine/v1)
# LUMA_API_BASE_URL=https://api.lumalabs.ai/dream-machine/v1
# Optional: must match the value Luma sends as x-luma-signature (see docs/SECRETS_AND_ALERTS.md)
LUMA_WEBHOOK_SECRET=
# Optional quality (defaults: 1080p, 9s)
# LUMA_VIDEO_RESOLUTION=1080p
# LUMA_VIDEO_DURATION=9s
